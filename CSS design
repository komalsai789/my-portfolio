
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #0b1120;
  --panel: #121c30;
  --text: #e8edf7;
  --muted: #a1aec3;
  --accent: #62e6c5;
  --border: #26344b;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

.navbar {
  position: sticky;
  top: 0;
  z-index: 10;
  min-height: 72px;
  padding: 16px 8%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: rgba(11, 17, 32, 0.96);
  border-bottom: 1px solid var(--border);
}

.logo {
  font-size: 23px;
  font-weight: 800;
}

.logo span,
h1 span,
h2 span {
  color: var(--accent);
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
}

nav a,
.social-links a {
  color: var(--muted);
  transition: color 0.2s;
}

nav a:hover,
.social-links a:hover {
  color: var(--accent);
}

.hero {
  min-height: 590px;
  padding: 90px 8%;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 55px;
}

.tag {
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.2;
  margin-bottom: 15px;
}

h2 {
  font-size: clamp(26px, 3vw, 38px);
  line-height: 1.3;
  margin-bottom: 20px;
}

.hero h2 {
  color: var(--muted);
  font-size: 23px;
}

.intro,
.section-text,
.contact-section > p {
  color: var(--muted);
  max-width: 650px;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin: 28px 0;
}

.btn {
  display: inline-block;
  padding: 11px 20px;
  border: 1px solid var(--accent);
  border-radius: 7px;
  font-weight: 700;
  transition: transform 0.2s, background 0.2s;
}

.btn:hover {
  transform: translateY(-2px);
}

.primary {
  background: var(--accent);
  color: #07131b;
}

.secondary {
  color: var(--accent);
}

.social-links {
  display: flex;
  gap: 22px;
  margin-top: 24px;
}

.hero-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 13px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
}

.terminal-bar {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 15px;
  border-bottom: 1px solid var(--border);
}

.terminal-bar span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #718096;
}

.terminal-bar p {
  margin-left: 8px;
  color: var(--muted);
  font-size: 12px;
}

.terminal {
  padding: 28px 22px;
  font-family: Consolas, monospace;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.terminal p {
  margin: 8px 0;
}

.indent {
  padding-left: 18px;
}

.green {
  color: var(--accent);
}

.yellow {
  color: #f4d58d;
}

.cursor {
  color: var(--accent);
}

.section {
  padding: 85px 8%;
}

.alternate {
  background: #0f192b;
}

.section-text {
  font-size: 17px;
}

.skill-grid,
.project-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 30px;
}

.skill,
.project {
  padding: 24px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.skill h3,
.project h3 {
  margin-bottom: 10px;
}

.skill p,
.project p {
  color: var(--muted);
}

.project-number {
  color: var(--accent) !important;
  font-size: 11px;
  letter-spacing: 1.5px;
  margin-bottom: 14px;
}

.project .tech {
  margin: 15px 0;
  color: var(--accent);
  font-size: 13px;
}

.project a {
  color: var(--accent);
  font-weight: 700;
}

.project a:hover {
  text-decoration: underline;
}

.note {
  color: var(--muted);
  font-size: 12px;
  margin-top: 22px;
}

.contact-section {
  text-align: center;
}

.contact-section > p {
  margin: 0 auto 20px;
}

.contact-section .note {
  margin-top: 18px;
}

footer {
  padding: 25px 8%;
  text-align: center;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 760px) {
  .navbar {
    position: static;
    flex-direction: column;
  }

  nav {
    justify-content: center;
    gap: 12px 18px;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 60px;
    gap: 35px;
  }

  .skill-grid,
  .project-grid {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 60px 7%;
  }
}
